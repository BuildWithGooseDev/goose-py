# Main service alignment (root .env uses CONFIG_SERVICE_PORT=8080)
GOOSE_SERVER_URL=http://192.168.50.9/sdk-api
GOOSE_POLL_INTERVAL_SECONDS=10

# One flagset per client path
# Must exist in the SDK client's organization.
GOOSE_FLAGSET_POLLTEST=edge-ui
GOOSE_FLAGSET_HOOKTEST=edge-ui
GOOSE_FLAGSET_SSETEST=edge-ui
GOOSE_NAMESPACE_POLLTEST=dev
GOOSE_NAMESPACE_HOOKTEST=dev
GOOSE_NAMESPACE_SSETEST=dev
GOOSE_CONFIG_NAMESPACE=dev
GOOSE_CONFIG_NAMES=edge-ui

GOOSE_SDK_CLIENT_ID=gsc_JGajl1GQ2lw10vkq
GOOSE_SDK_CLIENT_SECRET=DRkhhjDIFSSyOfj3VP2Yv-6zLKRMw57Z-Zs_do83Hpk

# Optional webhook mode settings
# Use host.docker.internal if config service is running in Docker and SDK runs on host.
GOOSE_WEBHOOK_TARGET_URL=http://host.docker.internal:8091/webhook
GOOSE_WEBHOOK_SECRET=goose-local-webhook-secret
GOOSE_WEBHOOK_LISTENER_HOST=0.0.0.0
GOOSE_WEBHOOK_LISTENER_PORT=8091
